# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Local virtual environments and package/build metadata
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Test, notebook, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.mplconfig/

# Local scheduler/runtime logs
slurm_logs/
slurm-*.out
*.log

# Generated result caches that are too large for normal Git history
results/**/trajectory_cache.npz
results/*_reference.pdf

# OS/editor clutter
.DS_Store
Thumbs.db
*~
*.swp
*.swo
